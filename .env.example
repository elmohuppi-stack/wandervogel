# Wandervogel — Konfiguration
#
# Kopieren nach .env und Passwort setzen:
#   cp .env.example .env
#
# Grundregel aus den Anforderungen: keine kostenpflichtigen APIs, keine
# API-Schlüssel. Alles hier ist entweder lokal oder ein offener Dienst.

# --- Datenbank -------------------------------------------------------------
POSTGRES_DB=wandervogel
POSTGRES_USER=wandervogel
POSTGRES_PASSWORD=bitte-aendern
# 5432 wird auf diesem Rechner teilweise belegt, deshalb 5433.
POSTGRES_PORT=5433

# Verbindungszeichenfolge für die App. Muss zu den Werten oben passen.
DATABASE_URL=postgres://wandervogel:bitte-aendern@localhost:5433/wandervogel

# --- Routing ---------------------------------------------------------------
BROUTER_VERSION=1.7.10
BROUTER_PORT=17777
BROUTER_URL=http://localhost:17777

# --- Höhendaten ------------------------------------------------------------
# Läuft immer über den eigenen Server (/api/dem), weil die offenen Quellen
# keine CORS-Header senden. Terrarium-kodiert.
#
# Entwicklung: offene AWS-Terrain-Kacheln.
# Betrieb: hier später auf lokale PMTiles-Dateien umstellen.
DEM_UPSTREAM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium

# --- Ortssuche -------------------------------------------------------------
# Läuft über den eigenen Server (/api/suche), nicht direkt aus dem Browser:
# so setzen wir den geforderten User-Agent, drosseln die Anfragen und
# zwischenspeichern Treffer.
#
# Entwicklung: der öffentliche Nominatim. Dessen Nutzungsregeln erlauben
# höchstens eine Anfrage pro Sekunde und verlangen eine Kennung.
# Betrieb: hier auf die eigene Nominatim-Instanz umstellen — die Anforderung
# verbietet Fremd-Fair-Use-Dienste im Dauerbetrieb.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Wandervogel/0.1 (selbst gehostete Tourenplanung)

# --- Basiskarte ------------------------------------------------------------
# Entwicklung: OpenFreeMap, frei und ohne Schlüssel.
# Betrieb: selbst gehostete Protomaps-PMTiles — die Anforderung verbietet
# Fremd-Fair-Use-Dienste im Dauerbetrieb.
PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Anwendung -------------------------------------------------------------
# Selbstregistrierung. Standard aus: Nutzer legt der Admin an.
PUBLIC_ALLOW_SIGNUP=false
